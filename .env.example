# ============================================================
#  NIGHTLIFE PARIS — MODÈLE DE CONFIGURATION
#  Copiez ce fichier en .env (local) ou collez ces variables
#  dans Vercel → Settings → Environment Variables (production).
#  Toutes sont optionnelles SAUF DATABASE_URL.
# ============================================================

# --- 1. BASE DE DONNÉES (obligatoire) -----------------------
# Base PostgreSQL gratuite. Crée-la sur https://neon.tech (sans carte bancaire),
# copie la "Connection string" (commence par postgresql://...).
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- 2. SÉCURITÉ (recommandé) -------------------------------
# Secret de signature des sessions (JWT). Génère-en un avec :  openssl rand -hex 32
AUTH_SECRET="remplace-moi-par-une-longue-chaine-aleatoire"

# --- 3. AGENT TIKTOK (contenu carrousel restaurants) --------
# 3a. AGENT IA — Clé Anthropic (pour générer les propositions de restaurants).
#     Crée un compte gratuit sur https://console.anthropic.com
#     → "API Keys" → "Create Key". Plan gratuit disponible.
ANTHROPIC_API_KEY=""

# 3b. VRAIES PHOTOS DES RESTAURANTS — Foursquare (GRATUIT, sans carte).
#     https://foursquare.com/developers → connexion → "Create a new project"
#     → dans le projet, génère une **Service Key** (ou utilise une clé legacy fsq3...).
#     Colle la clé telle quelle ici — les deux formats sont supportés.
FOURSQUARE_API_KEY=""

# 3c. IMAGES D'AMBIANCE — Clé Pexels (photos libres de droits, gratuite).
#     Compte gratuit sur https://www.pexels.com/api/ → "Your API Key".
#     Sans cette clé, des liens de recherche Pexels sont fournis à la place.
PEXELS_API_KEY=""

# 3d. URL publique de l'app (pour les liens de prévisualisation)
NEXT_PUBLIC_SITE_URL="https://ton-projet.vercel.app"

# --- 4. AGENT CANDIDATURES ----------------------------------
# Agent ManyChat (réception des inscriptions via DM Instagram).
#     Profil → Settings → API → "Your API Key"
MANYCHAT_API_KEY=""

# --- 5. WEBHOOKS (optionnel) --------------------------------
# Si défini, les webhooks /api/webhook/* exigent ce secret
# (header x-webhook-secret OU ?secret=...). Laisse vide pour les ouvrir.
WEBHOOK_SECRET=""

# --- 6. LEGACY (optionnel) ----------------------------------
# Google Places (vraies photos aussi, mais demande une carte bancaire)
GOOGLE_PLACES_API_KEY=""
META_ACCESS_TOKEN=""
META_IG_USER_ID=""
